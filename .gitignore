# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# Secrets & Environment Variables (CRITICAL)
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.sample
!.env.example

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated Reports & Heavy Output Artifacts
reports/*.pdf
reports/*.png
reports/*.html
reports/images/*
!reports/images/.gitkeep

# Generated Thumbnail Batches & Debug Crops (Preserves clean_templates/ and templates/)
reports/thumbnails/20*
reports/thumbnails/crop_*
reports/thumbnails/debug_*
reports/thumbnails/test_*
reports/thumbnails/verify_*
reports/thumbnails/day*
reports/thumbnails/Day_*
reports/thumbnails/original_*

# Temporary & Cache files
*.tmp
*.log
.cache/
