      "id": "20000001-0000-0000-0000-000000000003",
      "name": "The Hindu - National",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        560,
        200
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "url": "https://pib.gov.in/RssMain.aspx?ModId=6&LangId=1",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "User-Agent", "value": "Mozilla/5.0" }] },
        "options": {}
      },
      "id": "20000001-0000-0000-0000-000000000004",
      "name": "PIB Releases",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        560,
        400
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll"
      },
      "id": "20000001-0000-0000-0000-000000000005",
      "name": "Merge Ingested",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "function cleanHtml(t){if(!t||typeof t!=='string')return '';return t.replace(/<[^>]*>/g,' ').replace(/&amp;/g,'&').replace(/&quot;/g,'\"').replace(/\\s+/g,' ').trim();}\nconst items=[];for(const i of $input.all()){const d=i.json||{};const title=cleanHtml(d.title);if(!title)continue;items.push({json:{title,description:cleanHtml(d.description).substring(0,800),url:d.link||d.url||'',source:d.source||(d.link?.includes('thehindu')?'The Hindu':'PIB'),isPrimary:d.link?.includes('thehindu')||false,category:d.category||'National'}});}\nreturn items;"
      },
      "id": "20000001-0000-0000-0000-000000000006",
      "name": "Normalize & Deduplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        300
      ]
    },
    {
      "parameters": {
        "prompt": "=Analyze this story and conduct deep factual research for competitive exam prep:\n\nTitle: {{ $json.title }}\nSource: {{ $json.source }}\nURL: {{ $json.url }}\nDescription: {{ $json.description }}\n\nStrictly check facts against official knowledge. If uncertain, mark UNVERIFIED and assign confidence < 0.85.\n\nRespond with STRICT JSON ONLY:\n{\n  \"title\": \"{{ $json.title }}\",\n  \"category\": \"{{ $json.category }}\",\n  \"source\": \"{{ $json.source }}\",\n  \"url\": \"{{ $json.url }}\",\n  \"verified\": true,\n  \"confidence\": 0.95,\n  \"whatHappened\": \"Summary in 2-3 factual sentences\",\n  \"whyImportant\": \"Significance for Kerala PSC / UPSC / Banking\",\n  \"numbersAndData\": [\"Outlay / figures\"],\n  \"staticGkLinks\": [\"Constitutional article / act / HQ\"],\n  \"examPoints\": [\"Point 1\", \"Point 2\"],\n  \"sampleQuestion\": \"Exam MCQ question\",\n  \"sampleAnswer\": \"Correct answer\"\n}"
      },
      "id": "20000001-0000-0000-0000-000000000007",
      "name": "AI Fact Researcher",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.1
        }
      },
      "id": "20000001-0000-0000-0000-000000000008",
      "name": "OpenAI Model (Research)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        1200,
        500
      ],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nfor (const item of items) {\n  const res = item.json.text || item.json.response || '';\n  let parsed = {};\n  try {\n    parsed = JSON.parse(res.replace(/^```[a-z]*\\n?/i, '').replace(/\\n?```$/i, '').trim());\n  } catch (e) {\n    parsed = { title: 'Parse error', verified: false, confidence: 0.5, whatHappened: res };\n  }\n  const conf = typeof parsed.confidence === 'number' ? parsed.confidence : parseFloat(parsed.confidence) || 0.5;\n  const isVerified = parsed.verified === true && conf >= 0.85;\n  \n  results.push({\n    json: {\n      ...parsed,\n      confidence: conf,\n      verified: isVerified,\n      needsManualCheck: !isVerified,\n      verificationBadge: isVerified ? '✅ VERIFIED' : '⚠️ MANUAL_VERIFICATION_REQUIRED',\n      verificationNote: isVerified ? 'Verified with high confidence' : 'Low confidence: Cross-check with physical Hindu newspaper copy.'\n    }\n  });\n}\nreturn results;"
      },
      "id": "20000001-0000-0000-0000-000000000009",
      "name": "Confidence Gate Evaluator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.needsManualCheck }}",
              "value2": false
            }
          ]
        }
      },
      "id": "20000001-0000-0000-0000-000000000010",
      "name": "IF Verified (Confidence >= 0.85)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ]
    }
