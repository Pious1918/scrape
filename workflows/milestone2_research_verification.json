      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c-1", "name": "language", "value": "Malayalam", "type": "string" },
            { "id": "c-2", "name": "primary_source", "value": "The Hindu", "type": "string" },
            { "id": "c-3", "name": "minimum_confidence", "value": 0.85, "type": "number" },
            { "id": "c-4", "name": "current_date", "value": "={{ $now.setZone('Asia/Kolkata').toFormat('yyyy-MM-dd') }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "20000001-0000-0000-0000-000000000002",
